{
  "schemaVersion": 1,
  "id": "blackaddons",
  "version": "${version}",
  "name": "BlackAddons",
  "description": "Adds some neat features for Hypixel Skyblock",
  "authors": [
    "Blackum"
  ],
  "contributors": [
    "AtkLxve",
    "Autismo"
  ],
  "contact": {
    "homepage": "https://github.com/BLACKUM/BlackAddons",
    "sources": "https://github.com/BLACKUM/BlackAddons",
    "issues": "https://github.com/BLACKUM/BlackAddons/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/blackaddons/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "org.blackum.blackaddons.Blackaddons"
    ],
    "client": [
      "org.blackum.blackaddons.client.BlackaddonsClient"
    ],
    "modmenu": [
      "org.blackum.blackaddons.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "blackaddons.mixins.json",
    {
      "config": "blackaddons.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}